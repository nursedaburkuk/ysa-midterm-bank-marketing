{
  "optimizer": [
    "sgd",
    "adam",
    "adamw"
  ],
  "candidates_per_optimizer": 2,
  "hidden_layers": [
    [
      16
    ],
    [
      32
    ],
    [
      64
    ],
    [
      64,
      32
    ],
    [
      128,
      64
    ]
  ],
  "activation": [
    "relu",
    "tanh"
  ],
  "lr": {
    "adam": [
      0.0001,
      0.01
    ],
    "adamw": [
      0.0001,
      0.01
    ],
    "sgd": [
      0.001,
      0.1
    ],
    "distribution": "log-uniform"
  },
  "weight_decay": [
    0.0,
    1e-05,
    0.0001,
    0.001
  ],
  "batch_size": [
    32,
    64,
    128
  ],
  "scaler": [
    "standard",
    "minmax",
    "robust"
  ],
  "dropout": [
    0.0,
    0.2
  ],
  "clipping": [
    false,
    true
  ],
  "fixed": {
    "scheduler": true,
    "unknown": "category",
    "sgd_momentum": 0.9
  },
  "sampler": "sklearn.model_selection.ParameterSampler",
  "random_state_rule": "SEEDS['random_search'] + optimizer_index (sgd=0, adam=1, adamw=2)"
